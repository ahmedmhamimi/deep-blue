{
  "manifest_version": 3,
  "name": "DeepBlue",
  "version": "1.2",
  "description": "DeepBlue for Deepseek",
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": [
        "vendor/html2canvas.min.js",
        "vendor/jspdf.umd.min.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "deepblue-bridge.js"],
      "matches": ["https://chat.deepseek.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
